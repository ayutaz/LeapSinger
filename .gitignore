# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ── Secrets / local env（API トークン等。絶対にコミットしない）──────────
.env
.env.*
!.env.example
*.key
*.pem

# ── Virtual environments ────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── OS / editor cruft ───────────────────────────────────────────────────
.DS_Store
.AppleDouble
._*
.vscode/
.idea/
*.swp

# ── Datasets (users download the DBs and run preprocess themselves) ─────
data/
download/
*.npz
*.wav
*.flac
*.slab
*.TextGrid

# ── Model weights (distributed via GitHub Releases / Assets, not tracked)─
#    Exception: the small bundled inference vocoder is kept in-tree.
*.pt
*.ckpt
*.pth
*.onnx
!checkpoints/nhv_v3.onnx
!checkpoints/nhv_v3x.onnx

# ── HuggingFace caches that external tools write into checkpoints/ (Seed-VC does
#    this, relative to its cwd). Multi-GB, and they belong to other projects.
checkpoints/hf_cache/
checkpoints/models--*/

# ── Distributable OpenUTAU voicebanks (GitHub Releases Assets, not tracked)
checkpoints/leapsinger_oni_nat_ritsu/
*.zip

# ── Third-party terms text — bundled with the model Release, not committed here ──
doc/natume_term.txt

# ── Training logs / outputs / TensorBoard ───────────────────────────────
log/
logs/
runs/
out/
output/
wandb/
events.out.tfevents.*

# ── Not for public release ──────────────────────────────────────────────
_migration/

# ── doc/ is tracked now (demo page + figures live in doc/fig/), but the current ──
#    private working notes are not. New docs added here are tracked by default.
doc/SPEC.md
doc/SPEC.ja.md
doc/USAGE.ja.md
doc/mel_hop256_vs_hop512.md
doc/memo.md
doc/spec/
doc/readme_draft.md
# CREDITS.txt ships inside the model-release zip (it references the bundled
# Natsume terms file, which is not in the repo), so keep it out of the repo.
doc/CREDITS.txt

# ── doc/fig: track only the final overview figure; ignore sources + intermediates ──
doc/fig/leapsinger_overview_old.png
doc/fig/leapsinger_overview.svg
doc/fig/make_spectrograms.py
doc/fig/mel.png
doc/fig/pseudo_mel.png

# ── Deprecated lr16 (1.6e-3) configs — superseded by the lr8 recipe ──────
configs/full_oni_nat_ritsu_3style_uv.yaml
configs/multispk_oni_nat_ritsu_bs2_lr16.yaml

# ── Unused per-phoneme v/uv dict (experimental feature deferred) ─────────
dict/ja_phoneme_vuv.yaml

# ── Notebook demo assets ────────────────────────────────────────────────
# Track the small demo input (wav + lab). The model checkpoint is distributed via the
# GitHub Release, not committed — download it into notebooks/sample_data/ to run the notebook.
# (The exported ONNX is large and regenerated by the notebook, so it stays untracked.)
!notebooks/sample_data/*.wav
notebooks/exported_model/

# ── Scratch / temporary ─────────────────────────────────────────────────
.smoke/
scratch/
tmp/
*.tmp
onnxruntime_profile_*.json

# Private: former base trainer, superseded by the GAN train.py
/train_old.py

# ── M0 の素材置き場（公開コーパスのダウンロード先。コミットしない）──
.m0data/
